# ===== MODELO LOCAL (Fase 1 - FUNCIONANDO) =====
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_MODEL=qwen2.5:14b
# Variables de sistema ya configuradas: OLLAMA_VULKAN=1, OLLAMA_FLASH_ATTENTION=1

# ===== ANTHROPIC (Claude) =====
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_INTERVAL_SECONDS=2100   # 35 minutos

# ===== GEMINI (GRATIS - 1000 req/dia) =====
GOOGLE_API_KEY=AIza...
GEMINI_MODEL=gemini-2.5-flash

# ===== OPENAI (GPT + web search) =====
OPENAI_API_KEY=sk-...
GPT_MODEL=gpt-5.4-nano
NEWS_SEARCH_MODEL=gpt-4o-mini-search-preview
NEWS_SEARCH_FALLBACK_MODEL=gpt-4o-mini-search-preview

# ===== DEEPSEEK (análisis quant/matemático — muy barato) =====
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-chat   # V3.2 — $0.27/$1.10 por MTok

# ===== BINANCE TESTNET =====
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_SECRET=
BINANCE_TESTNET=true

# ===== TRADING CONFIG =====
TRADING_PAIRS=BTCUSDT,ETHUSDT
ANALYSIS_INTERVAL_SECONDS=900  # 15 minutos
MARKET_REFRESH_SECONDS=30      # refresco de precio/indicadores del dashboard (24/7, sin LLM)

# ===== HORARIO DE TRADING (limita solo el decisor; el monitor de posiciones corre 24/7) =====
TRADING_HOURS_ENABLED=true
TRADING_HOURS_START=8          # hora de inicio (incluida)
TRADING_HOURS_END=20           # hora de fin (excluida) — ventana de 12h
TRADING_TIMEZONE=UTC           # zona horaria de la ventana (ej: UTC, America/Bogota, America/New_York)
MAX_POSITION_SIZE_PERCENT=25.0   # margen maximo por posicion sobre budget (cubre notional MAX/leverage)
MAX_DAILY_LOSS_PERCENT=5.0
FUTURES_MAX_DAILY_LOSS_PCT=0     # limite de perdida diaria en futures (0 = desactivado; solo aplica el hard stop)
MIN_CONSENSUS_SCORE=0.58
MIN_REWARD_RISK=1.2              # reward:risk minimo (TP/SL). Bloquea entradas sin espacio al objetivo
MIN_POSITION_USDT=450.0
MAX_POSITION_USDT=600.0
TRADING_BUDGET_USDT=1000.0
MAX_TRADING_LOSS_USDT=700.0      # perdida acumulada antes del hard stop (70% del budget)
FUTURES_LEVERAGE=3
DECISION_MODE=DEEPSEEK_SINGLE
MIN_CONVICTION=0.58
DEEPSEEK_DECISION_MODEL=deepseek-v4-pro
DEEPSEEK_DECISION_TIMEOUT_SECONDS=45
# Claude auditor: in-line veto on EVERY BUY/SELL before execution (fail-open if Claude errors/runs out of tokens).
# DISABLED — it vetoed too many setups that would eventually have been profitable (3+ days with zero execution).
# Claude now runs ONLY the learning module (post-mortems + daily review, see CLAUDE_ADVISOR_ENABLED).
# Set this back to true to re-enable the in-line veto.
CLAUDE_AUDIT_ENABLED=false
CLAUDE_AUDIT_MODEL=claude-sonnet-4-6
# Claude learning module: per-trade post-mortems + daily strategy review (does NOT block trades)
CLAUDE_ADVISOR_ENABLED=true

# ===== MEMPALACE =====
MEMPALACE_PATH=C:\Users\Rael\.mempalace

# ===== WEB SEARCH AGENT =====
NEWS_INTERVAL_SECONDS=10800
NEWS_SEARCH_MODEL=gpt-4o-mini-search-preview
NEWS_SEARCH_MAX_USES=8
TAVILY_API_KEY=tvly-...
NEWS_AVOID_THRESHOLD=-0.70
# Fallback when OpenAI runs out of credits: MiMo via OpenRouter with :online web search (Exa).
# Leave NEWS_FALLBACK_API_KEY empty to disable the fallback (it also reuses OPENROUTER_API_KEY if set).
NEWS_SEARCH_FALLBACK_MODEL=xiaomi/mimo-v2.5-pro:online
NEWS_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
NEWS_FALLBACK_API_KEY=
NEWS_FALLBACK_MAX_TOKENS=5000   # MiMo is a reasoning model (variable 1.4k-2.6k thinking tokens); high cap avoids truncation (only generated tokens are billed)

# ===== REDIS =====
REDIS_URL=redis://localhost:6379

# ===== SERVERS =====
API_PORT=8000
DASHBOARD_PORT=5173
